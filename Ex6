<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopFeedback | Professional Survey</title>
    <style>
        /* --- PROFESSIONAL THEME VARIABLES --- */
        :root {
            /* Palette: Slate & Indigo */
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --secondary: #64748b;
            --bg-body: #f8fafc;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0; /* The "Line" color */
            --success: #10b981;
            --error: #ef4444;
            
            /* Spacing & Radius */
            --radius-md: 8px;
            --radius-lg: 16px;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }

        /* --- GLOBAL RESET & TYPOGRAPHY --- */
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            line-height: 1.5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            -webkit-font-smoothing: antialiased;
        }

        /* Container Utility - Flex Column to stick footer to bottom */
        .container {
            width: 100%;
            max-width: 500px;
            padding: 2.5rem;
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            position: relative;
            z-index: 10;
            text-align: center;
            display: flex;
            flex-direction: column;
            min-height: 400px; /* Ensures footer has space */
        }

        .wide { max-width: 850px; text-align: left; }

        /* --- VIEW 1: WELCOME (HERO) --- */
        #view-welcome {
            background: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.5)), 
                        url('https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
            
            width: 100vw;
            height: 100vh;
            max-width: none;
            border-radius: 0;
            box-shadow: none;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 20px;
            position: relative;
        }

        .hero-content {
            max-width: 700px;
            animation: fadeIn 1s ease-out;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
            line-height: 1.1;
        }

        .hero-content p {
            font-size: 1.25rem;
            opacity: 0.9;
            margin-bottom: 2.5rem;
            font-weight: 300;
        }

        .btn-hero {
            display: inline-block;
            background: white;
            color: var(--primary);
            padding: 1rem 2.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }

        .btn-hero:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px rgba(0,0,0,0.3);
        }

        /* Welcome Footer */
        .footer-welcome {
            position: absolute;
            bottom: 0;
            width: 100%;
            padding: 2rem 1rem;
            text-align: center;
            color: rgba(255,255,255,0.8);
            font-size: 0.9rem;
            z-index: 20;
        }
        .footer-welcome a { color: white; text-decoration: none; margin: 0 15px; opacity: 0.8; transition: 0.2s; font-weight: 500; }
        .footer-welcome a:hover { opacity: 1; text-decoration: underline; }

        /* --- VIEW 2: LOGIN --- */
        #view-login {
            background: url('https://images.unsplash.com/photo-1556742049-0cfed4f7a07d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80') no-repeat center center/cover;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            max-width: none;
            border-radius: 0;
            box-shadow: none;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(12px);
            padding: 3rem;
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 420px;
            box-shadow: var(--shadow-xl);
            animation: slideUp 0.5s ease-out;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 400px;
        }

        /* Login Footer - Neat Line */
        .footer-login {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.8rem;
            color: var(--secondary);
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        /* --- NAVBAR --- */
        .nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 2rem;
        }

        .nav h2 { font-size: 1.25rem; font-weight: 700; color: var(--text-main); }
        .nav a { text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: 0.2s; }
        .nav a.logout { color: var(--error); }
        .nav a.logout:hover { color: #b91c1c; }
        .nav a.back-link { color: var(--secondary); }
        .nav a.back-link:hover { color: var(--text-main); }

        /* --- FORMS & INPUTS --- */
        .form-group { margin-bottom: 1.5rem; text-align: left; }
        
        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-main);
        }

        input[type="text"], input[type="password"], select, textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 1rem;
            transition: all 0.2s;
            background: #f8fafc;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .btn-primary {
            width: 100%;
            padding: 0.875rem;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-primary:hover { background: var(--primary-dark); }

        /* --- STARS --- */
        .star-rating {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 4px;
            font-size: 1.75rem;
        }
        .star-rating input { display: none; }
        .star-rating label { 
            color: #cbd5e1; 
            cursor: pointer; 
            margin: 0; 
            transition: color 0.2s, transform 0.2s;
        }
        .star-rating label:hover { transform: scale(1.1); }
        .star-rating input:checked ~ label,
        .star-rating label:hover,
        .star-rating label:hover ~ label { color: #f59e0b; }

        /* --- DASHBOARD --- */
        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 1rem;
            flex-grow: 1;
        }

        .card {
            display: block;
            padding: 2rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            text-decoration: none;
            color: var(--text-main);
            transition: all 0.3s ease;
            background: white;
        }

        .card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-lg);
            transform: translateY(-4px);
        }

        .card-icon {
            font-size: 2rem;
            margin-bottom: 1rem;
            display: block;
        }

        .card h3 { margin: 0 0 0.5rem 0; color: var(--text-main); font-size: 1.25rem; }
        .card p { margin: 0; color: var(--secondary); font-size: 0.95rem; }

        /* --- STANDARD FOOTER (Home & Survey) - NEAT LINE --- */
        .standard-footer {
            margin-top: auto; /* Pushes to bottom if container is flex */
            padding-top: 2rem; /* Space above the line */
            border-top: 1px solid var(--border); /* THE NEAT LINE */
            display: flex;
            flex-direction: column;
            gap: 15px;
            text-align: center;
            color: var(--secondary);
            font-size: 0.85rem;
        }

        /* Desktop Layout for Footer */
        @media (min-width: 640px) {
            .standard-footer {
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                text-align: left;
            }
        }

        .footer-links a { 
            color: var(--secondary); 
            text-decoration: none; 
            margin-left: 1.5rem; 
            font-size: 0.85rem; 
            transition: color 0.2s;
            font-weight: 500;
        }
        .footer-links a:hover { color: var(--primary); }
        .footer-links a:first-child { margin-left: 0; }

        /* --- UTILITIES --- */
        .hidden { display: none !important; }
        
        .alert {
            padding: 1rem;
            border-radius: var(--radius-md);
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            text-align: center;
        }
        .alert-error { background: #fef2f2; color: var(--error); border: 1px solid #fecaca; }
        .alert-success { background: #ecfdf5; color: var(--success); border: 1px solid #a7f3d0; }

        .product-context {
            background: #f1f5f9;
            padding: 1rem;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            border-left: 4px solid var(--primary);
        }
        
        .section-header {
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--secondary);
            font-weight: 700;
            margin: 2rem 0 1rem 0;
            border-bottom: 1px solid var(--border);
            padding-bottom: 0.5rem;
        }

        /* Animations */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    </style>
</head>
