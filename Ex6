    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const path = window.location.pathname;
            const views = {
                'view-welcome': document.getElementById('view-welcome'),
                'view-login': document.getElementById('view-login'),
                'view-home': document.getElementById('view-home'),
                'view-survey': document.getElementById('view-survey')
            };

            function hideAll() {
                Object.values(views).forEach(el => el.classList.add('hidden'));
            }

            if (path === '/welcome') {
                hideAll();
                views['view-welcome'].classList.remove('hidden');
            } 
            else if (path === '/login') {
                hideAll();
                views['view-login'].classList.remove('hidden');
                if (new URLSearchParams(window.location.search).get('error') === 'invalid') {
                    document.getElementById('login-error').classList.remove('hidden');
                }
            } 
            else if (path === '/home') {
                hideAll();
                views['view-home'].classList.remove('hidden');
                if (new URLSearchParams(window.location.search).get('status') === 'success') {
                    document.getElementById('home-success').classList.remove('hidden');
                }
            } 
            else if (path === '/survey') {
                hideAll();
                views['view-survey'].classList.remove('hidden');
            } 
            else {
                hideAll();
                views['view-welcome'].classList.remove('hidden');
            }
        });
    </script>
